# Server Configuration
PORT=5000
FLASK_ENV=development

# AI Provider Configuration: "auto", "gemini", "openai", or "mock"
# Default is "auto", which uses GEMINI_API_KEY if present, then OPENAI_API_KEY, or falls back to mock.
AI_PROVIDER=auto

# Google Gemini API Key (Recommended for IdeaForge)
GEMINI_API_KEY=

# OpenAI API Key
OPENAI_API_KEY=
